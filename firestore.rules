rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function businessExists(businessId) {
      return businessId is string
        && businessId.size() > 0
        && exists(/databases/$(database)/documents/BusinessShop/$(businessId));
    }

    function validBusinessHours(data) {
      return data.keys().hasAll([
          'closedDays',
          'openingTime',
          'closingTime',
          'businessShopId'
        ])
        && data.keys().hasOnly([
          'closedDays',
          'openingTime',
          'closingTime',
          'businessShopId'
        ])
        && data.closedDays is list
        && data.closedDays.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && data.openingTime is string
        && data.openingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.closingTime is string
        && data.closingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.openingTime < data.closingTime
        && businessExists(data.businessShopId);
    }

    function validBookableResource(data) {
      return data.keys().hasAll(['name'])
        && data.keys().hasOnly(['name', 'BusinessId', 'type', 'active'])
        && data.name is string
        && data.name.size() > 0
        && (!('BusinessId' in data) || businessExists(data.BusinessId))
        && (!('type' in data) || data.type == 'BARBER')
        && (!('active' in data) || data.active is bool);
    }

    function validException(data) {
      return data.keys().hasAll([
          'startAt',
          'endAt',
          'resourceId',
          'reason'
        ])
        && data.keys().hasOnly([
          'startAt',
          'endAt',
          'resourceId',
          'reason',
          'BusinessId'
        ])
        && data.startAt is string
        && data.startAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$')
        && data.endAt is string
        && data.endAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$')
        && data.endAt > data.startAt
        && data.resourceId is string
        && data.resourceId.size() > 0
        && exists(/databases/$(database)/documents/BookableResource/$(data.resourceId))
        && data.reason is string
        && data.reason.size() > 0
        && (!('BusinessId' in data)
          || (businessExists(data.BusinessId)
            && get(/databases/$(database)/documents/BookableResource/$(data.resourceId)).data.BusinessId == data.BusinessId));
    }

    match /BusinessShop/{businessId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }

    match /BusinessHours/{hoursId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validBusinessHours(request.resource.data);
      allow delete: if isAdmin();
    }

    match /BookableResource/{resourceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validBookableResource(request.resource.data);
      allow delete: if isAdmin();
    }

    match /AvailabilityException/{exceptionId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validException(request.resource.data);
      allow delete: if isAdmin();
    }

    match /Booking/{bookingId} {
      // Customer booking creation is not enabled yet. Keep all booking access admin-only.
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
